# Create a Supabase project, then copy these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Emails allowed into the admin panel, comma-separated. The middleware reads
# ADMIN_EMAILS (plural); with the old ADMIN_EMAIL name set, nobody gets in.
ADMIN_EMAILS=admin@example.com
# Optional. Overrides the registration form in content/event.ts.
# NEXT_PUBLIC_REGISTRATION_URL=
